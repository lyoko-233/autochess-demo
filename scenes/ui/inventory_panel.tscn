[gd_scene load_steps=3 format=3]
[ext_resource type="Theme" path="res://assets/ui/game_theme.tres" id="Theme"]
[ext_resource type="Script" path="res://scripts/ui/inventory_panel.gd" id="1"]

[node name="InventoryPanel" type="PanelContainer"]
theme = ExtResource("Theme")
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Gold" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"HUDNumber"
theme_override_colors/font_color = Color(0.96, 0.79, 0.38, 1)
theme_override_font_sizes/font_size = 25
horizontal_alignment = 2
text = "金币 1"

[node name="Divider" type="HSeparator" parent="Content"]
layout_mode = 2

[node name="Heading" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Content/Heading"]
layout_mode = 2
size_flags_horizontal = 3
text = "装备"

[node name="Tools" type="Button" parent="Content/Heading"]
layout_mode = 2
theme_type_variation = &"CompactButton"
theme_override_font_sizes/font_size = 14
text = "合成 / 管理"
flat = true

[node name="ItemsScroll" type="ScrollContainer" parent="Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 110)
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Items" type="GridContainer" parent="Content/ItemsScroll"]
layout_mode = 2
columns = 4

[node name="Hint" type="Label" parent="Content"]
layout_mode = 2
visible = false
