[gd_scene load_steps=2 format=3]
[ext_resource type="Theme" path="res://assets/ui/game_theme.tres" id="Theme"]

[node name="TraitsPanel" type="PanelContainer"]
theme = ExtResource("Theme")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Heading" type="Label" parent="Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "阵容羁绊"

[node name="Scroll" type="ScrollContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Traits" type="VBoxContainer" parent="Content/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6
